# The ClearSpend app's generated SDK (@clearspend/sdk) comes from the enrollment's npm registry.
# The token is read from the FOUNDRY_TOKEN environment variable when npm runs. No token is stored here (CLAUDE.md).
@clearspend:registry=https://roshan-amble.usw-3.palantirfoundry.com/artifacts/api/repositories/ri.artifacts.main.repository.6332d363-5ea8-47a8-b3a7-525178d182d2/contents/release/npm/
//roshan-amble.usw-3.palantirfoundry.com/artifacts/api/repositories/ri.artifacts.main.repository.6332d363-5ea8-47a8-b3a7-525178d182d2/contents/release/npm/:_authToken=${FOUNDRY_TOKEN}
omit-lockfile-registry-resolved=true
# The supplier app's generated SDK (@clearspend-suppliers/sdk), from the "ClearSpend Suppliers" app's registry.
@clearspend-suppliers:registry=https://roshan-amble.usw-3.palantirfoundry.com/artifacts/api/repositories/ri.artifacts.main.repository.886de6d1-c87f-41d0-8d13-599a4848cff5/contents/release/npm/
