{
  "name": "clearspend",
  "private": true,
  "type": "module",
  "description": "Sourcing intelligence for a nonprofit food program expansion, on Palantir Foundry and AIP.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p packages/domain && tsc -p scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:market": "tsx scripts/build-market-prices.ts",
    "fixtures:validate": "vitest run scripts",
    "ontology:payloads": "tsx scripts/ontology-payloads.ts",
    "domain:sync": "tsx scripts/sync-domain.ts",
    "functions:harness": "bash scripts/functions-harness.sh",
    "functions:typecheck": ".functions-harness/node_modules/.bin/tsc -p ../clearspend-functions/typescript-functions/src/tsconfig.json --noEmit",
    "import": "tsx scripts/import.ts",
    "verify:snapshot": "tsx scripts/verify-snapshot.ts",
    "test:d6": "tsx scripts/d6-guard-test.ts",
    "test:actor": "tsx scripts/actor-guard-test.ts",
    "record:verifications": "tsx scripts/record-verifications.ts",
    "ai": "tsx scripts/ai-run.ts",
    "profile:ids": "tsx scripts/profile-ids.ts",
    "eval:ai": "tsx scripts/ai-eval.ts",
    "test:outreach": "tsx scripts/outreach-test.ts",
    "test:studio": "tsx scripts/studio-roundtrip.ts",
    "test:target": "tsx scripts/target-test.ts",
    "portfolio:generate": "tsx scripts/generate-portfolio.ts",
    "portfolio:check": "tsx scripts/portfolio-check.ts",
    "portfolio:upload": "tsx scripts/upload-portfolio.ts",
    "portfolio:import": "tsx scripts/import-portfolio.ts",
    "test:investigations": "tsx scripts/investigation-test.ts",
    "test:offers": "tsx scripts/offers-test.ts",
    "dev:supplier": "npm run dev -w @clearspend/supplier",
    "demo:reset": "tsx scripts/reset-country.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "csv-parse": "^5.6.0",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vitest": "^3.0.5"
  }
}
